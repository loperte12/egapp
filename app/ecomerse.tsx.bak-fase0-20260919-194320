function ProductCard({ product, favorited, onPress, onFav, onAdd }: {
  product: EcomerseProduct; favorited: boolean; onPress: () => void; onFav: () => void; onAdd: () => void;
}) {
  const { colors } = useTheme();
  const condition = typeof product.attributes?.estado === 'string' ? product.attributes.estado : null;
  return (
    <View style={[s_card.card, { backgroundColor: colors.card, borderColor: colors.border }]}>
      {/* Capa de detalle (debajo de los controles, sin anidar Pressables) */}
      <Pressable style={StyleSheet.absoluteFill} onPress={onPress} accessibilityRole="button" accessibilityLabel={product.title} />
      {product.photos?.[0] ? (
        <Image source={{ uri: product.photos[0] }} style={{ width: '100%', height: 128, backgroundColor: colors.surface }} contentFit="cover" transition={200} />
      ) : (
        <View style={{ width: '100%', height: 128, backgroundColor: alpha(colors.primary, 0.08), alignItems: 'center', justifyContent: 'center' }}>
          <Text style={{ fontSize: 32 }}>{product.categoryIcon ?? '📦'}</Text>
        </View>
      )}
      {/* Etiquetas: destacado + tienda Pro (columna, sin magia de offsets) */}
      {(product.isFeatured || product.seller?.badge === 'Pro') && (
        <View style={s_card.badges}>
          {product.isFeatured && <View style={s_card.featBadge}><Text style={s_card.featText}>🔥</Text></View>}
          {product.seller?.badge === 'Pro' && <View style={s_card.proBadge}><Text style={s_card.proText}>PRO</Text></View>}
        </View>
      )}
      {/* Corazón favorito (hermano de la capa de detalle) */}
      <Pressable onPress={onFav} hitSlop={10} accessibilityRole="button" accessibilityLabel={favorited ? 'Quitar de favoritos' : 'Añadir a favoritos'} style={s_card.fav}>
        <Heart size={16} color={favorited ? brand.like : brand.white} fill={favorited ? brand.like : 'rgba(0,0,0,0.35)'} />
      </Pressable>
      <View style={s_card.body} pointerEvents="none">
        <Text numberOfLines={2} style={[s_card.title, { color: colors.textPrimary }]}>{product.title}</Text>
        <View style={s_card.priceRow}>
          <Text style={s_card.price}>{formatXAF(Number.isFinite(product.priceXaf) ? product.priceXaf : 0)}</Text>
          {condition ? <Text style={[s_card.condition, { color: colors.textSecondary }]}>{condition}</Text> : null}
        </View>
        <View style={s_card.meta}>
          <Text numberOfLines={1} style={[s_card.city, { color: colors.textSecondary }]}>{product.city}</Text>
          <View style={{ flexDirection: 'row', alignItems: 'center', gap: 8 }}>
            {/* INTERÉS (patrón `FavoriteCountGuard` de Dewu, ver `dewu-github-aprovechable.md`).
                La ficha ya enseñaba «N fav», pero la TARJETA —donde el comprador decide— no. Dewu
                modela esto con un contador y varias versiones del texto según el espacio; aquí se usa
                la versión corta y se muestra SOLO si hay alguien: un «0 fav» o un «0 vistas» espanta
                más de lo que informa. El corazón va delante para que se lea como señal social y no
                como métrica. */}
            {product.favoriteCount > 0 && (
              <Text style={[s_card.interest, { color: colors.textSecondary }]}>♥ {product.favoriteCount}</Text>
            )}
            {product.favoriteCount === 0 && product.views > 0 && (
              <Text style={[s_card.interest, { color: colors.textSecondary }]}>{product.views} vistas</Text>
            )}
            <Pressable onPress={onAdd} hitSlop={6} accessibilityRole="button" accessibilityLabel={`Añadir ${product.title} al carrito`} style={s_card.addBtn}>
              <ShoppingCart size={12} color={brand.white} />
              <Text style={s_card.addText}>Añadir</Text>
            </Pressable>
          </View>
        </View>
        {/* VENDEDOR (tanda 2 de la comparación con 得物/Dewu). La tarjeta enseñaba foto, título,
            precio, estado y ciudad, pero NO de quién es. En un mercado entre particulares esa es
            la pregunta que sigue a «¿cuánto?», y sin ella hay que abrir la ficha para saber si
            detrás hay una tienda o alguien suelto. Se muestra el nombre del negocio si lo tiene. */}
        {product.seller?.businessName ? (
          <Text numberOfLines={1} style={[s_card.seller, { color: colors.textSecondary }]}>
            {product.seller.badge === 'Pro' ? 'PRO · ' : ''}{product.seller.businessName}
            {/* La nota solo si EXISTE. Un «★ 0.0» o un «sin valoraciones» en cada tarjeta de una
                tienda nueva es ruido que además desanima; el detalle sí lo explica. */}
            {product.seller.ratingCount > 0 ? ` · ★ ${product.seller.ratingAvg.toFixed(1)}` : ''}
          </Text>
        ) : null}
      </View>
    </View>
  );
}
