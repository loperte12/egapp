/**
 * EcomerseScreen — Home del marketplace "Mercado" (estilo Xianyu adaptado GQ).
 * v5 (auditoría senior): error de red con Reintentar (nunca "no hay productos"),
 * sin datos stale al filtrar, subcategoría limpia al cambiar de categoría,
 * búsqueda server-side con debounce, favoritos con sesión, carrito siempre
 * navegable, sin teléfonos PII en el feed (WhatsApp solo en detalle), CTA
 * "Añadir" en tarjeta, grid par, a11y, pull-to-refresh, SafeArea y skeletons.
 * Ruta: /ecomerse
 */

import React, { useCallback, useEffect, useMemo, useState } from 'react';
import {
  ActivityIndicator, Alert, FlatList, Modal, Pressable, ScrollView, StyleSheet,
  Text, TextInput, View,
} from 'react-native';
import { Image } from 'expo-image';
import * as ImagePicker from 'expo-image-picker';
import { useRouter } from 'expo-router';
import { useSafeAreaInsets } from 'react-native-safe-area-context';
import { ArrowLeft, Camera, Heart, Search, ShoppingCart, Store, X } from 'lucide-react-native';
import { useTheme, alpha, EmptyState, InlineError, tipografia, radios, EstadoDinero } from '@egrouteplan/ui-kit';
import { ecomerseApi, EcomerseCategory, EcomerseProduct } from '../api/ecomerse';
import { useEcomerseStore } from '../state/ecomerse';
import { useSession } from '../state/session';
import { formatXAF } from '../utils/formatHelpers';
import { CITIES } from '../constants/data';
import { brand } from '@egrouteplan/ui-kit';

const GRID_COLS = 5;
const VISIBLE_CATS = 10;
const MAX_PHOTO_MB = 8;

/**
 * ORDEN DEL CATÁLOGO (tanda A — patrón del `/search` «综合搜索、筛选、排序» de macrozheng/mall, que
 * hace búsqueda, filtro y orden en un solo endpoint).
 *
 * Por qué existe: el backend **ya ordenaba** (`catalog()` acepta `sort`) y la app **ya lo mandaba**,
 * pero fijo a 'recommended'. El usuario no podía elegir. Esto no añade ni una consulta nueva.
 *
 * Los `id` tienen que coincidir EXACTAMENTE con el `switch` de `ecomerse.service.ts`, o el
 * servidor caería en el caso por defecto sin avisar.
 */
const SORTS = [
  { id: 'recommended', label: 'Recomendados' },
  { id: 'price_asc', label: 'Precio ↑' },
  { id: 'price_desc', label: 'Precio ↓' },
  { id: 'rating', label: 'Mejor valorados' },
  { id: 'newest', label: 'Novedades' },
] as const;
type SortKey = (typeof SORTS)[number]['id'];

const PLACEHOLDER_CARDS = [0, 1, 2, 3];

export default function EcomerseScreen() {
  const { colors } = useTheme();
  const router = useRouter();
  const insets = useSafeAreaInsets();
  const { isAuthenticated } = useSession();
  const {
    query, setQuery, categoryFilter, setCategoryFilter, subcategoryFilter, setSubcategoryFilter,
    cityFilter, setCityFilter, favIds, setFavIds, toggleFavId, cart, addToCart,
  } = useEcomerseStore();

  const [products, setProducts] = useState<EcomerseProduct[]>([]);
  const [recommended, setRecommended] = useState<EcomerseProduct[]>([]);
  const [cats, setCats] = useState<EcomerseCategory[]>([]);
  const [loading, setLoading] = useState(true);
  /** Orden del catálogo. Los valores coinciden con el `switch` de `ecomerse.service.ts`. */
  const [sort, setSort] = useState<SortKey>('recommended');
  const [error, setError] = useState<string | null>(null);
  const [showAllCats, setShowAllCats] = useState(false);
  const [showCityModal, setShowCityModal] = useState(false);
  const [imageResults, setImageResults] = useState<EcomerseProduct[]>([]);
  const [imageActive, setImageActive] = useState(false);
  /* El fallo de la búsqueda por foto se guarda para enseñarlo EN la pantalla: antes se
     convertía en una lista vacía + un Alert, o sea en un «no hay resultados» falso. */
  const [imageError, setImageError] = useState<string | null>(null);
  const [imageBusy, setImageBusy] = useState(false);

  // Carga con debounce: búsqueda server-side + filtros. Nunca datos stale:
  // se vacían los productos al empezar; recomendados son globales (sin ciudad).
  const load = useCallback(async () => {
    setLoading(true);
    setError(null);
    setProducts([]);
    try {
      const q: Record<string, string> = {};
      if (categoryFilter) q.category = categoryFilter;
      if (subcategoryFilter) q.subcategory = subcategoryFilter;
      if (cityFilter) q.city = cityFilter; // contrato API: nombre (ILIKE normalizado sin tildes)
      const t = query.trim();
      if (t) q.q = t;
      /* ORDENACIÓN (tanda A). El servidor ya sabía ordenar (`catalog()` acepta `sort` desde
         siempre) y la app ya lo mandaba, pero fijo a 'recommended': el usuario no podía elegir.
         Ahora `sort` sale del selector. Los valores tienen que coincidir EXACTAMENTE con los del
         `switch` de `ecomerse.service.ts`. */
      q.sort = sort;
      const [p, c, rec] = await Promise.all([
        ecomerseApi.catalog(q),
        ecomerseApi.categories(),
        ecomerseApi.catalog({ sort: 'recommended' }),
      ]);
      setProducts(p);
      setCats(c);
      setRecommended(rec.slice(0, 8));
    } catch {
      setError('No pudimos cargar el mercado. Revisa tu conexión e inténtalo de nuevo.');
      setProducts([]);
      setRecommended([]);
    } finally {
      setLoading(false);
    }
  }, [categoryFilter, subcategoryFilter, cityFilter, query, sort]);

  useEffect(() => {
    const t = setTimeout(() => { load(); }, 300);
    return () => clearTimeout(t);
  }, [load]);

  // Favoritos: sincroniza ids (silencioso si no hay sesión)
  useEffect(() => {
    let alive = true;
    ecomerseApi.favoriteIds().then((ids) => { if (alive) setFavIds(ids); }).catch(() => undefined);
    return () => { alive = false; };
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, []);

  /** Búsqueda por foto: valida, avisa y sube; imageActive se activa al empezar
   *  para que el banner muestre "Buscando…" mientras trabaja. */
  const searchByPhoto = async () => {
    try {
      const perm = await ImagePicker.requestMediaLibraryPermissionsAsync();
      if (!perm.granted) {
        Alert.alert('Permiso de fotos', 'Necesitamos acceso a tu galería para buscar por imagen.');
        return;
      }
      const res = await ImagePicker.launchImageLibraryAsync({ mediaTypes: ['images'], quality: 0.7 });
      if (res.canceled || !res.assets?.[0]) return; // cancelado ≠ error
      const asset = res.assets[0];
      if ((asset.fileSize ?? 0) > MAX_PHOTO_MB * 1024 * 1024) {
        Alert.alert('Foto demasiado pesada', `Usa una imagen de menos de ${MAX_PHOTO_MB} MB.`);
        return;
      }
      const type = asset.mimeType ?? 'image/jpeg';
      if (!type.startsWith('image/')) {
        Alert.alert('Archivo no válido', 'Selecciona una imagen.');
        return;
      }
      setImageActive(true);
      setImageBusy(true);
      setImageError(null);
      try {
        const form = new FormData();
        form.append('image', { uri: asset.uri, name: 'foto.jpg', type } as unknown as Blob);
        const r = await ecomerseApi.searchImage(form);
        setImageResults(r.products ?? []);
      } catch (e) {
        /*
          NO se convierte en «sin resultados»: se guarda el fallo y se enseña con `InlineError`
          (que además lo anuncia al lector de pantalla). Antes esto era `setImageResults([])` +
          un Alert, y el usuario leía que su foto no servía cuando el problema era otro.
        */
        setImageResults([]);
        setImageError(e instanceof Error && e.message ? e.message : 'No se pudo procesar la imagen. Prueba con otra foto.');
      } finally {
        setImageBusy(false);
      }
    } catch { /* picker falló por el sistema */ }
  };

  const activeCat = cats.find((c) => c.id === categoryFilter);
  const cartCount = cart.reduce((a, c) => a + c.qty, 0);
  const cityLabel = CITIES.find((c) => c.id === cityFilter)?.name ?? (cityFilter || 'Todas las ciudades');

  const listData: EcomerseProduct[] = useMemo(() => {
    const base = imageActive ? imageResults : products;
    if (loading && !products.length && !imageActive) return PLACEHOLDER_CARDS.map((i) => ({ id: `__sk_${i}` } as EcomerseProduct));
    return base.length % 2 === 1 ? [...base, { id: '__spacer__' } as EcomerseProduct] : base;
  }, [imageActive, imageResults, products, loading]);

  const isPlaceholder = (id: string) => id.startsWith('__sk_');

  const chooseCat = (catId: string) => {
    const next = categoryFilter === catId ? '' : catId;
    setCategoryFilter(next);
    setSubcategoryFilter(''); // nunca arrastrar la subcategoría de otra categoría
    setShowAllCats(false);
  };

  const s = styles(colors);
  return (
    <View style={[s.root, { paddingTop: insets.top }]}>
      {/* Header */}
      <View style={s.header}>
        <Pressable onPress={() => router.back()} hitSlop={12} accessibilityRole="button" accessibilityLabel="Volver">
          <ArrowLeft size={22} color={colors.textPrimary} />
        </Pressable>
        <Text style={s.headerTitle}>Mercado</Text>
        <View style={s.headerActions}>
          <Pressable onPress={() => router.push('/ecomerse-favorites' as any)} hitSlop={12} accessibilityRole="button"
            accessibilityLabel={favIds.length ? `Favoritos, ${favIds.length}` : 'Favoritos'}>
            <Heart size={20} color={favIds.length ? brand.like : colors.textPrimary} />
          </Pressable>
          <Pressable onPress={() => router.push('/ecomerse-checkout' as any)} hitSlop={12} accessibilityRole="button"
            accessibilityLabel={cartCount ? `Carrito, ${cartCount} productos` : 'Carrito vacío'}>
            <ShoppingCart size={20} color={colors.textPrimary} />
            {cartCount > 0 && (
              <View style={s.cartBadge}><Text style={s.cartBadgeText}>{cartCount > 9 ? '9+' : cartCount}</Text></View>
            )}
          </Pressable>
          <Pressable onPress={() => router.push('/ecomerse-seller' as any)} hitSlop={12} accessibilityRole="button" accessibilityLabel="Mi tienda">
            <Store size={20} color={colors.primary} />
          </Pressable>
        </View>
      </View>

      <FlatList
        data={listData}
        keyExtractor={(item) => item.id}
        numColumns={2}
        columnWrapperStyle={s.colWrap}
        contentContainerStyle={s.listContent}
        keyboardShouldPersistTaps="handled"
        refreshing={loading && products.length > 0}
        onRefresh={load}
        ListHeaderComponent={
          imageActive ? (
            <View style={[s.photoBanner, { backgroundColor: alpha(colors.primary, 0.08), borderColor: colors.border }]}>
              <Text style={[s.photoBannerTitle, { color: colors.textPrimary }]}>🔍 Resultados de tu foto</Text>
              <Text style={[s.photoBannerSub, { color: colors.textSecondary }]}>
                {imageBusy ? 'Buscando productos similares…' : `${imageResults.length} producto${imageResults.length === 1 ? '' : 's'} similar${imageResults.length === 1 ? '' : 'es'}`}
              </Text>
              <Pressable onPress={() => setImageActive(false)} style={s.photoBack} accessibilityRole="button">
                <Text style={s.photoBackText}>← Volver al catálogo</Text>
              </Pressable>
            </View>
          ) : (
          <View>
            {/* Búsqueda */}
            <View style={s.searchBox}>
              <Search size={16} color={colors.textSecondary} />
              <TextInput
                value={query}
                onChangeText={setQuery}
                placeholder="Buscar móvil, ropa, comida…"
                placeholderTextColor={colors.textSecondary}
                accessibilityLabel="Buscar en el mercado"
                returnKeyType="search"
                autoCorrect={false}
                style={s.searchInput}
              />
              <Pressable onPress={searchByPhoto} hitSlop={10} disabled={imageBusy} accessibilityRole="button"
                accessibilityLabel="Buscar por foto" style={{ marginLeft: 8 }}>
                {imageBusy ? <ActivityIndicator size="small" color={colors.primary} /> : <Camera size={18} color={colors.primary} />}
              </Pressable>
            </View>

            {/* Solo en mi ciudad — selector con TODAS las ciudades de GQ */}
            <View style={s.cityRow}>
              <Pressable onPress={() => setShowCityModal(true)} accessibilityRole="button" accessibilityLabel="Elegir ciudad"
                style={[s.cityPicker, { backgroundColor: colors.surface, borderColor: colors.border }]}>
                <Text style={s.cityLabel}>📍 {cityLabel}</Text>
                <Text style={{ fontSize: tipografia.caption, color: colors.textSecondary }}>▾</Text>
              </Pressable>
              {cityFilter !== '' && (
                <Pressable onPress={() => setCityFilter('')} hitSlop={8} accessibilityRole="button">
                  <Text style={[s.seeAll, { fontSize: tipografia.caption }]}>Quitar filtro</Text>
                </Pressable>
              )}
            </View>

            {/* Confianza (encima del fold). Antes era una frase suelta («✅ Pago en efectivo o por
                la app · Garantía de 7 días…») que el usuario tenía que creer. Ahora dice LO QUE
                HACE la plataforma con el dinero, que es verificable y es lo que Dewu no puede
                decir. Compacto a propósito: en la home no cabe el bloque de tres pasos.
                El margen va aquí fuera porque el primitivo no conoce el ritmo de esta pantalla
                (16, el mismo que `sectionHead`). */}
            <View style={{ paddingHorizontal: 16, marginTop: 8 }}>
              <EstadoDinero activo="retenido" compacto />
            </View>

            {/* ORDENAR (tanda A). Va entre el filtro de ciudad y las categorías: es donde el usuario
                ya está decidiendo «qué me enseñas», y no compite con las categorías, que son «de qué
                categoría». Los chips dicen el orden elegido con `accessibilityState`, no solo con
                color. */}
            <View style={{ marginTop: 12 }}>
              <Text style={[s.sectionTitle, { paddingHorizontal: 16, marginBottom: 6 }]}>Ordenar por</Text>
              <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: 8, paddingHorizontal: 16 }}>
                {SORTS.map((o) => {
                  const on = sort === o.id;
                  return (
                    <Pressable
                      key={o.id}
                      onPress={() => setSort(o.id)}
                      accessibilityRole="radio"
                      accessibilityState={{ checked: on }}
                      accessibilityLabel={`Ordenar por ${o.label}`}
                      style={{
                        paddingHorizontal: 12, paddingVertical: 7, borderRadius: radios.lg,
                        backgroundColor: on ? colors.primary : colors.surface,
                        borderWidth: 1, borderColor: on ? colors.primary : colors.border,
                      }}
                    >
                      <Text style={{ fontSize: tipografia.caption, fontWeight: '700', color: on ? brand.white : colors.textPrimary }}>
                        {o.label}
                      </Text>
                    </Pressable>
                  );
                })}
              </ScrollView>
            </View>

            {/* Categorías */}
            <View style={s.sectionHead}>
              <Text style={s.sectionTitle}>Categorías</Text>
              <Pressable onPress={() => setShowAllCats(true)} hitSlop={8} accessibilityRole="button">
                <Text style={s.seeAll}>Ver todas ({cats.length})</Text>
              </Pressable>
            </View>
            {loading && cats.length === 0 ? (
              <View style={s.catGrid}><CatSkeletonGrid colors={colors} /></View>
            ) : (
              <View style={s.catGrid}>
                {cats.slice(0, VISIBLE_CATS).map((c) => (
                  <CatCell key={c.id} cat={c} active={categoryFilter === c.id} onPress={() => chooseCat(c.id)} />
                ))}
                <CatCell cat={null} label="Ver todas" icon="⋯" active={false} onPress={() => setShowAllCats(true)} />
              </View>
            )}

            {/* Subcategorías de la categoría activa */}
            {activeCat && (
              <ScrollView horizontal showsHorizontalScrollIndicator={false} style={s.subRow} contentContainerStyle={{ gap: 8, paddingRight: 16 }}>
                <SubChip label="Todas" active={subcategoryFilter === ''} onPress={() => setSubcategoryFilter('')} />
                {(activeCat.subs ?? []).map((sub) => (
                  <SubChip key={sub.id} label={sub.label} active={subcategoryFilter === sub.id}
                    onPress={() => setSubcategoryFilter(subcategoryFilter === sub.id ? '' : sub.id)} />
                ))}
              </ScrollView>
            )}

            {/* Recomendados (globales; no se ocultan al filtrar) */}
            {recommended.length > 0 && (
              <>
                <View style={[s.sectionHead, { marginTop: 4 }]}>
                  <Text style={s.sectionTitle}>🔥 Recomendados</Text>
                </View>
                <ScrollView horizontal showsHorizontalScrollIndicator={false} contentContainerStyle={{ gap: 10, paddingRight: 16 }}>
                  {recommended.map((p) => (
                    <RecCard key={p.id} product={p} onPress={() => router.push({ pathname: '/ecomerse-detail', params: { id: p.id } } as any)} />
                  ))}
                </ScrollView>
              </>
            )}

            {/* Contador de resultados */}
            {!error && (
              <Text style={s.resultsLabel}>
                {loading ? 'Cargando…' : `${products.length} producto${products.length === 1 ? '' : 's'}`}
              </Text>
            )}
          </View>
          )
        }
        ListEmptyComponent={
          imageActive ? (
            /* Tres estados distintos, y antes eran uno: mientras busca se enseña que busca, si
               falla se dice que falló (con reintento), y solo si de verdad no hay resultados se
               enseña el vacío. El vacío, además, ahora es el del kit. */
            imageBusy ? (
              <View style={{ alignItems: 'center', paddingTop: 48 }}>
                <ActivityIndicator color={colors.primary} />
                <Text style={{ color: colors.textSecondary, fontSize: tipografia.body, marginTop: 10 }}>Buscando productos parecidos…</Text>
              </View>
            ) : imageError ? (
              <View style={{ paddingTop: 40, paddingHorizontal: 32 }}>
                <InlineError mensaje={imageError} onReintentar={() => void searchByPhoto()} etiquetaReintento="Elegir otra foto" />
              </View>
            ) : (
              <EmptyState
                icono={<Text style={{ fontSize: 38 }}>📷</Text>}
                titulo="No encontramos productos parecidos"
                texto="Prueba con otra foto más nítida, de frente y con buena luz, o busca por texto."
                accionLabel="← Volver al catálogo"
                onAccion={() => setImageActive(false)}
              />
            )
          ) : error ? (
            /*
              El error, con el componente del kit: se anuncia al lector de pantalla, vibra y trae
              su propio reintento. Era un bloque a mano con 📡 y un botón de estilo propio.
            */
            <View style={{ paddingTop: 40, paddingHorizontal: 32 }}>
              <InlineError mensaje={`No pudimos cargar el catálogo. ${error}`} onReintentar={load} />
            </View>
          ) : loading ? null : (
            /* El vacío del kit. Antes este archivo definía el suyo: tres formas de hacer lo
               mismo en el mismo producto. Las dos caras van en un solo objeto para no repetir
               cinco veces la condición de «hay filtros». */
            <EmptyState
              icono={<Text style={{ fontSize: 40 }}>🛍️</Text>}
              {...((!!categoryFilter || !!subcategoryFilter || !!cityFilter || !!query.trim())
                ? {
                    titulo: 'Sin resultados con estos filtros',
                    texto: 'Prueba a quitar filtros o buscar en otra ciudad.',
                    accionLabel: 'Quitar filtros',
                    onAccion: () => { setCategoryFilter(''); setSubcategoryFilter(''); setCityFilter(''); setQuery(''); },
                  }
                : {
                    titulo: 'Todavía no hay productos',
                    texto: 'Sé el primero en publicar: identidad verificada + aprobación del administrador.',
                    accionLabel: 'Publicar mi primer producto',
                    accionPrimaria: true,
                    onAccion: () => router.push('/ecomerse-seller' as any),
                  })}
            />
          )
        }
        renderItem={({ item }) =>
          isPlaceholder(item.id) ? (
            <CardSkeleton key={item.id} colors={colors} />
          ) : item.id === '__spacer__' ? (
            <View key="spacer" style={{ flex: 1 }} />
          ) : (
            <ProductCard
              product={item}
              favorited={favIds.includes(item.id)}
              onPress={() => router.push({ pathname: '/ecomerse-detail', params: { id: item.id } } as any)}
              onFav={() => {
                if (!isAuthenticated) {
                  Alert.alert('Inicia sesión', 'Para guardar favoritos entra en tu cuenta.');
                  return;
                }
                toggleFavId(item.id);
                ecomerseApi.favoritesToggle(item.id).catch(() => {
                  toggleFavId(item.id);
                  Alert.alert('Favoritos', 'No se pudo guardar. Inténtalo de nuevo.');
                });
              }}
              onAdd={() => {
                addToCart({ productId: item.id, title: item.title, priceXaf: item.priceXaf, qty: 1, photos: item.photos ?? [], stock: item.stock, city: item.city });
              }}
            />
          )
        }
      />

      {/* Modal Ver todas las categorías */}
      <Modal visible={showAllCats} animationType="slide" transparent onRequestClose={() => setShowAllCats(false)}>
        <Pressable style={s.modalWrap} onPress={() => setShowAllCats(false)} accessibilityViewIsModal>
          <Pressable style={[s.modalCard, { backgroundColor: colors.card }]}>
            <View style={s.modalHead}>
              <Text style={s.modalTitle}>Todas las categorías</Text>
              <Pressable onPress={() => setShowAllCats(false)} hitSlop={12} accessibilityRole="button" accessibilityLabel="Cerrar">
                <X size={20} color={colors.textPrimary} />
              </Pressable>
            </View>
            <FlatList data={cats} numColumns={GRID_COLS} keyExtractor={(c) => c.id}
              renderItem={({ item }) => (
                <CatCell cat={item} active={categoryFilter === item.id} onPress={() => chooseCat(item.id)} />
              )}
              contentContainerStyle={{ paddingBottom: 24 }}
            />
          </Pressable>
        </Pressable>
      </Modal>

      {/* Modal Elegir ciudad */}
      <Modal visible={showCityModal} animationType="slide" transparent onRequestClose={() => setShowCityModal(false)}>
        <Pressable style={s.modalWrap} onPress={() => setShowCityModal(false)} accessibilityViewIsModal>
          <Pressable style={[s.modalCard, { backgroundColor: colors.card }]}>
            <View style={s.modalHead}>
              <Text style={s.modalTitle}>Elige tu ciudad</Text>
              <Pressable onPress={() => setShowCityModal(false)} hitSlop={12} accessibilityRole="button" accessibilityLabel="Cerrar">
                <X size={20} color={colors.textPrimary} />
              </Pressable>
            </View>
            <FlatList
              data={[{ id: '__all__', name: 'Todas las ciudades', region: '' }, ...CITIES]}
              keyExtractor={(c) => c.id}
              renderItem={({ item }) => (
                <Pressable
                  onPress={() => { setCityFilter(item.id === '__all__' ? '' : item.name); setShowCityModal(false); }}
                  accessibilityRole="button"
                  style={[s.cityItem, { borderBottomColor: colors.border }]}>
                  <Text style={{ fontSize: 14.5, fontWeight: '700', color: cityFilter === item.name || (item.id === '__all__' && !cityFilter) ? colors.primary : colors.textPrimary }}>
                    {item.name}
                  </Text>
                  {item.region ? <Text style={{ fontSize: tipografia.caption, color: colors.textSecondary }}>{item.region}</Text> : null}
                </Pressable>
              )}
              contentContainerStyle={{ paddingBottom: 24 }}
            />
          </Pressable>
        </Pressable>
      </Modal>
    </View>
  );
}

// ---------------------------------------------------------------------------
// Componentes
// ---------------------------------------------------------------------------

function CatCell({ cat, label, icon, active, onPress }: {
  cat: EcomerseCategory | null; label?: string; icon?: string; active: boolean; onPress: () => void;
}) {
  const { colors } = useTheme();
  const lbl = label ?? cat?.label ?? '';
  const ic = icon ?? cat?.icon ?? '📦';
  return (
    <Pressable onPress={onPress} accessibilityRole="button" accessibilityLabel={lbl} style={s_cat.cell}>
      <View style={[s_cat.iconWrap, { backgroundColor: active ? alpha(colors.primary, 0.15) : colors.surface, borderColor: active ? colors.primary : colors.border }]}>
        <Text style={s_cat.icon}>{ic}</Text>
      </View>
      <Text numberOfLines={2} style={[s_cat.label, { color: active ? colors.primary : colors.textPrimary }]}>{lbl}</Text>
    </Pressable>
  );
}
const s_cat = StyleSheet.create({
  cell: { flex: 1, alignItems: 'center', paddingVertical: 6, maxWidth: '20%' },
  iconWrap: { width: 46, height: 46, borderRadius: 14, alignItems: 'center', justifyContent: 'center', borderWidth: 1, marginBottom: 6 },
  icon: { fontSize: 22 },
  label: { fontSize: 10.5, fontWeight: '700', textAlign: 'center', paddingHorizontal: 2 },
});

function SubChip({ label, active, onPress }: { label: string; active: boolean; onPress: () => void }) {
