function SubChip({ label, active, onPress }: { label: string; active: boolean; onPress: () => void }) {
  const { colors } = useTheme();
  return (
    <Pressable onPress={onPress} accessibilityRole="button" accessibilityLabel={label}
      style={{ paddingHorizontal: 12, paddingVertical: 6, borderRadius: radios.md, backgroundColor: active ? colors.primary : colors.surface, borderWidth: 1, borderColor: active ? colors.primary : colors.border }}>
      <Text style={{ fontSize: tipografia.caption, fontWeight: '700', color: active ? brand.white : colors.textPrimary }}>{label}</Text>
    </Pressable>
  );
}

/**
 * LA FILA DE HOJAS Y SU PANEL ABIERTO — 23-sep-2026.
 *
 * Es la pieza de la referencia (Pinduoduo) que faltaba: **una fila de chips con un caret a la
 * derecha que la abre entera**, en dos estados, colapsada y desplegada.
 *
 * HACÍA FALTA AQUÍ MÁS QUE EN LA REFERENCIA, y es un dato, no una impresión. Allí los rótulos miden
 * 2-5 caracteres y en una fila entran cinco o seis. Los nuestros, medidos sobre las **502 hojas
 * vivas**: mínimo 4, **mediana 15**, máximo 38 caracteres («Farmacia D.O.M. (Deus Optimus
 * Maximus)»). En un móvil de 360 dp eso son **dos o tres chips por pantalla**, así que sin la forma
 * abierta una familia con 16 hojas —Supermercados— se recorre a ciegas, deslizando sin saber cuánto
 * queda. El reparto medido: 36 familias con 1-3 hojas, 66 con 4-6, 3 con 7-9, 4 con 10-14 y 1 con 16.
 *
 * EL CARET SOLO SALE SI EL CARRIL DESBORDA DE VERDAD, y eso se mide: ancho del contenido
 * (`onContentSizeChange`) contra ancho del carril (`onLayout`). Un umbral fijo de hojas no valdría
 * —«Aceite» (6) y «Farmacia D.O.M. (Deus Optimus Maximus)» (38) no ocupan lo mismo— y un caret
 * permanente en las 102 familias que caben sería cromo que no hace nada. La condición además es
 * **monótona**, que es lo que impide el parpadeo: enseñar el caret solo le quita ancho al carril y
 * el contenido no cambia, así que lo que ya desbordaba sigue desbordando y lo que no desbordaba
 * nunca lo ve aparecer.
 *
 * AL ELEGIR, SE CIERRA — y ahí se discrepa de la referencia, que deja el panel abierto. El motivo es
 * que aquí el panel tapa el feed y su razón de ser es ENCONTRAR: elegido el chip, lo que se quiere
 * ver son los productos. El precio de cerrar es que el chip elegido puede quedar fuera de la
 * pantalla, y eso convertiría la elección en invisible; por eso al cerrar el carril **se desplaza
 * hasta él**. La posición de cada chip se toma de su `onLayout` (el `x` dentro del contenido, que no
 * cambia al cambiar el ancho de la ventana porque es relativo al contenido).
 */
function FilaHojas({ familia, activeId, onPick }: {
  familia: EcomerseFamily;
  activeId: string;
  onPick: (id: string) => void;
}) {
  const { colors } = useTheme();
  const [abierta, setAbierta] = useState(false);
  const [anchoCarril, setAnchoCarril] = useState(0);
  const [anchoContenido, setAnchoContenido] = useState(0);
  const carril = useRef<ScrollView>(null);
  const posiciones = useRef<Record<string, number>>({});
  /** El chip que hay que dejar a la vista en cuanto el carril vuelva a estar montado. */
  const porVer = useRef<string | null>(null);

  /** Los +1 de margen no son decoración: `onContentSizeChange` redondea y sin él un contenido que
   *  cabe por medio píxel sacaría el caret para nada. */
  const desborda = anchoContenido > anchoCarril + 1;

  /* El desplazamiento al chip elegido va en un efecto y no en el `onPress`: con el panel abierto el
   * carril NO está montado (el `return` de abajo lo sustituye), así que en el momento de pulsar la
   * referencia es `null`. Cuando el efecto corre, el estado ya cambió y el carril existe. */
  useEffect(() => {
    if (abierta || porVer.current === null) return;
    const id = porVer.current;
    porVer.current = null;
    const x = posiciones.current[id];
    if (x !== undefined) carril.current?.scrollTo({ x: Math.max(0, x - espaciado.lg), animated: true });
  }, [abierta]);

  const elegir = (id: string) => {
    /* Volver a pulsar el chip puesto lo quita, que es como se comportaba esta fila antes del panel
       y como se comporta la pestaña de departamento. */
    const nuevo = activeId === id ? '' : id;
    porVer.current = nuevo || null;
    onPick(nuevo);
    setAbierta(false);
  };

  /* Los chips son los mismos en los dos estados, y por eso se escriben una vez: en el carril se
     deslizan y en el panel se envuelven, pero un chip no cambia de forma ni de contenido. */
  const chips = (
    <>
      <View onLayout={(e) => { posiciones.current[''] = e.nativeEvent.layout.x; }}>
        <SubChip label="Todas" active={activeId === ''} onPress={() => elegir('')} />
      </View>
      {familia.hojas.map((h) => (
        <View key={h.id} onLayout={(e) => { posiciones.current[h.id] = e.nativeEvent.layout.x; }}>
          <SubChip label={h.label} active={activeId === h.id} onPress={() => elegir(h.id)} />
        </View>
      ))}
    </>
  );

  if (abierta) {
    return (
      <View style={[s_hojas.panel, { backgroundColor: colors.surface, borderColor: colors.border }]}>
        <Pressable onPress={() => setAbierta(false)} accessibilityRole="button"
          accessibilityLabel={`Cerrar las categorías de ${familia.label}`} style={s_hojas.panelCabecera}>
          <Text style={[s_hojas.panelTitulo, { color: colors.textSecondary }]} numberOfLines={1}>{familia.label}</Text>
          <ChevronUp size={ilustracion.sm} color={colors.textSecondary} />
        </Pressable>
        <View style={s_hojas.panelCuerpo}>{chips}</View>
      </View>
    );
  }

  return (
    <View style={s_hojas.fila}>
      <ScrollView ref={carril} horizontal showsHorizontalScrollIndicator={false} style={s_hojas.carril}
        contentContainerStyle={s_hojas.carrilContenido}
        onLayout={(e) => setAnchoCarril(e.nativeEvent.layout.width)}
        onContentSizeChange={(w) => setAnchoContenido(w)}>
        {chips}
      </ScrollView>
      {desborda && (
        <Pressable onPress={() => setAbierta(true)} accessibilityRole="button"
          accessibilityLabel={`Ver las ${familia.hojas.length + 1} categorías de ${familia.label}`}
          style={s_hojas.caret}>
          <ChevronDown size={ilustracion.sm} color={colors.textSecondary} />
        </Pressable>
      )}
    </View>
  );
}

/**
 * Los estilos de la fila de hojas, al nivel del módulo y **sin colores**: los que dependen del tema
 * van en línea (`colors.surface`, `colors.border`, `colors.textSecondary`), que es el patrón que ya
 * sigue `s_home` aquí al lado. Solo tokens: así la guardia de diseño (`npm run diseno`) no ve un
 * solo `fontWeight`, `borderWidth` ni hex nuevos, que es exactamente lo que cuenta.
 */
const s_hojas = StyleSheet.create({
  fila: { flexDirection: 'row', alignItems: 'center', marginTop: espaciado.sm },
  carril: { flex: 1, paddingLeft: espaciado.lg },
  carrilContenido: { gap: espaciado.sm, paddingRight: espaciado.sm },
  /** El área táctil del caret: `ilustracion.sm` (20) de icono más el relleno, para no quedar por
   *  debajo del mínimo táctil de Android. */
  caret: { paddingHorizontal: espaciado.sm, paddingVertical: espaciado.md, justifyContent: 'center' },
  panel: { marginTop: espaciado.sm, marginHorizontal: espaciado.lg, padding: espaciado.md, borderRadius: radios.md, borderWidth: trazo.fino },
  panelCabecera: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingBottom: espaciado.sm },
  panelTitulo: { flex: 1, fontSize: tipografia.caption, fontWeight: peso.fuerte },
  /** `flexWrap` con chips de ancho natural, y no las 4 columnas de la referencia: en una columna de
   *  un cuarto de pantalla (80 dp) el rótulo mediano —15 caracteres— sale cortado, y el motivo de
   *  abrir el panel es justamente **leer los nombres**. El chip conserva así el alto de una línea y
   *  la forma que ya tenía en el carril, así que al abrir y cerrar no salta nada. */
  panelCuerpo: { flexDirection: 'row', flexWrap: 'wrap', gap: espaciado.sm },
});

/** Aquí vivieron tres esqueletos de la zona de categorías, y ninguno llegó a tiempo: `CatSkeletonGrid`
 *  (5 cuadrados de 46 en fila) se retiró al pasar la home a la pila de avatares, `AvatarStackEsqueleto`
 *  (los círculos con su solape) al pasar la home a las pestañas + rejilla el 23-sep-2026. El que vive
 *  ahora es `PestanasEsqueleto`, unas barras del ancho de una pestaña: dibuja **lo que va a llegar**
 *  —nombres de departamento— y no una forma que luego no aparece. Regla que sacaron los tres: un
 *  esqueleto que no mide lo mismo que el contenido hace saltar la cabecera al cargar. */

const styles = (c: ReturnType<typeof useTheme>['colors']) => StyleSheet.create({
  root: { flex: 1, backgroundColor: c.background },
  /**
   * Fondo SÓLIDO + elevación: es lo que despega la cabecera del catálogo que se desliza por
   * debajo. Sin `backgroundColor` la barra era transparente y, al desplazar, la fila de tarjetas
   * cortada por el borde de la lista se leía pegada al título, sin separación ninguna.
   * `paddingVertical` bajó de 12 a 8 al mudarse aquí la barra de búsqueda: 8 + 40 + 8 = 56 dp de
   * cabecera, el alto estándar de una barra de app de Android. Con 12 serían 64 y se comía el
   * sitio de una tarjeta y media.
   */
  header: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: espaciado.lg, paddingVertical: espaciado.sm, backgroundColor: c.background, borderBottomWidth: trazo.fino, borderBottomColor: c.border, zIndex: 2, elevation: 2 },
  headerActions: { flexDirection: 'row', alignItems: 'center', gap: 14 },
  cartBadge: { position: 'absolute', top: -6, right: -8, minWidth: 16, height: 16, borderRadius: radios.sm, backgroundColor: brand.like, alignItems: 'center', justifyContent: 'center', paddingHorizontal: 3 },
  cartBadgeText: { color: brand.white, fontSize: tipografia.micro, fontWeight: peso.titulo },
  /**
   * La barra de búsqueda, en la cabecera. `height: 40` en vez de `paddingVertical`: es lo que la
   * hace caber junto a los tres iconos de acción y quedar centrada con ellos, y evita que el alto
   * dependa del `font_scale` del usuario (con un `paddingVertical` fijo, a 1.3 de escala la barra
   * crecía y desalineaba la fila entera). Los 40 dp son de la barra, no del área táctil: la barra
   * entera es el campo, así que el alto táctil ya es de sobra.
   */
  headerSearch: { flex: 1, flexDirection: 'row', alignItems: 'center', marginHorizontal: espaciado.md, height: 40, paddingHorizontal: espaciado.md, backgroundColor: c.surface, borderRadius: radios.md, borderWidth: trazo.fino, borderColor: c.border },
  /** `paddingVertical: 0` es obligatorio en Android: el `TextInput` trae relleno vertical propio y,
   *  sin quitarlo, desborda los 40 dp de la barra por arriba y por abajo. */
  searchInput: { flex: 1, color: c.textPrimary, fontSize: tipografia.body, marginLeft: espaciado.sm, paddingVertical: 0 },
  /* Aquí vivían `cityRow`, `cityPicker`, `cityLabel` y `cityItem` (el carril de ciudad) y `seeAll`
     («Ver todas (18)», el acceso al modal de categorías). Se retiraron el 23-sep-2026 con el cromo
     de la cabecera: sus dos pantallas ya no existen, así que eran cinco hojas de estilo que nadie
     podía aplicar. Un `StyleSheet` con claves muertas no molesta al compilador, pero hace creer que
     la ciudad y el modal siguen ahí a quien lea el archivo. */
  sectionHead: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: 16, marginTop: 16, marginBottom: 8 },
  sectionTitle: { fontSize: tipografia.body, fontWeight: '800', color: c.textPrimary },
  /* Aquí vivía `subRow` (el carril de hojas). Se retiró el 23-sep-2026 al mudarse la fila a su
     propio componente (`FilaHojas`), que trae sus estilos en `s_hojas`: dejarla habría sido una hoja
     de estilo que nadie aplica, y el patrón del archivo —`s_home` al lado— ya dice que los estilos de
     un componente de módulo viven con él, no en el `styles()` de la pantalla. */
  resultsLabel: { fontSize: tipografia.caption, fontWeight: '700', color: c.textSecondary, paddingHorizontal: 16, marginTop: 16, marginBottom: 10 },
  colWrap: { gap: 10, paddingHorizontal: 16 },
  listContent: { paddingBottom: 32 },
  /* `modalWrap`/`modalCard`/`modalHead`/`modalTitle` murieron con los dos modales de la home
     (ciudad y «Todas las categorías»), retirados el 23-sep-2026. El `Modal` ya no está importado
     en este archivo: si vuelve a hacer falta un modal, se trae el `Modal` y con él su envoltorio. */
  photoBanner: { marginHorizontal: 16, marginTop: 12, borderRadius: radios.md, borderWidth: 1, padding: 14, alignItems: 'center' },
  photoBannerTitle: { fontSize: tipografia.body, fontWeight: '800' },
  photoBannerSub: { fontSize: tipografia.caption, marginTop: 4 },
  photoBack: { marginTop: 10, paddingHorizontal: 14, paddingVertical: 7, borderRadius: radios.lg, backgroundColor: c.primary },
  photoBackText: { color: brand.white, fontSize: tipografia.caption, fontWeight: '800' },
});
