/**
 * Celda de la rejilla de la hoja «Todas las categorías» (`GRID_COLS` = 4 por fila).
 *
 * Ya NO la usa la home: la home pasó al avatar stack. Por eso se le quitaron los dos parámetros
 * `label`/`icon` que existían solo para pintar la celda falsa «⋯ Ver todas» de la rejilla vieja —
 * ahora esta función tiene un único llamador y un único trabajo.
 *
 * El círculo se cambió de cuadrado redondeado a **círculo** para que una categoría se vea igual en
 * la home y en la hoja: es el mismo objeto, no dos.
 */
function CatCell({ cat, active, onPress }: { cat: EcomerseCategory; active: boolean; onPress: () => void }) {
  const { colors } = useTheme();
  return (
    <Pressable onPress={onPress} accessibilityRole="button" accessibilityState={{ selected: active }}
      accessibilityLabel={cat.label} style={s_cat.cell}>
      <View style={[s_cat.iconWrap, {
        backgroundColor: active ? alpha(colors.primary, 0.16) : colors.surface,
        borderColor: active ? colors.primary : colors.border,
        borderWidth: active ? trazo.fuerte : trazo.fino,
      }]}>
        <Text style={s_cat.icon}>{cat.icon ?? '📦'}</Text>
      </View>
      <Text numberOfLines={2} ellipsizeMode="tail" style={[s_cat.label, { color: active ? colors.primary : colors.textPrimary }]}>{cat.label}</Text>
    </Pressable>
  );
}

/**
 * AVATAR STACK DE CATEGORÍAS — la home.
 *
 * Traducción del patrón al caso: los «avatares» son las categorías (el emoji que manda el backend
 * dentro de un círculo), el `max` es `MAX_AVATARES_CAT` y la píldora «+N» hace exactamente lo que
 * hace en el original —decir cuántos quedan y abrir la lista completa—. Del original NO se traen
 * dos cosas, y por motivos distintos: el `hover` que abre hueco entre avatares (aquí no hay ratón; en
 * táctil el hueco de la primera pregunta se tapa con el dedo de la segunda) y el `tooltip` con el
 * nombre (en 48 dp no cabe un nombre como «Materiales de construcción»; el nombre vive en el
 * `accessibilityLabel` de cada avatar y en la hoja, donde sí se lee).
 *
 * El 1.º y el 6.º avatar conservan los 48 dp táctiles enteros; los de en medio, los 32 dp que quedan
 * al descubierto. La cuenta está en `MAX_AVATARES_CAT`.
 *
 * El estado «elegida» se marca con **anillo, no con relleno**: rellenar el círculo de color primario
 * convierte la categoría elegida en una mancha y se come el emoji justo cuando el usuario la está
 * mirando. El anillo dice lo mismo sin tapar el icono, y el `accessibilityState` lo dice sin
 * depender del color.
 */
function AvatarStackCats({ cats, activeId, onPick, onVerTodas }: {
  cats: EcomerseCategory[]; activeId: string;
  onPick: (id: string) => void; onVerTodas: () => void;
}) {
  const { colors } = useTheme();
  const visibles = cats.slice(0, MAX_AVATARES_CAT);
  const resto = cats.length - visibles.length;
  return (
    <View style={s_cat.stack}>
      {visibles.map((c, i) => {
        const on = activeId === c.id;
        return (
          <Pressable
            key={c.id}
            onPress={() => onPick(c.id)}
            accessibilityRole="button"
            accessibilityState={{ selected: on }}
            accessibilityLabel={c.label}
            style={[
              s_cat.avatar,
              {
                marginLeft: i === 0 ? 0 : -SOLAPE_AVATAR,
                /* zIndex DESCENDENTE: el primero tapa al segundo, y así hasta el final. Es como se
                   apila un avatar stack de verdad (el de más a la izquierda se ve entero) y mantiene
                   el orden de lectura de izquierda a derecha. Al revés, el último taparía a todos. */
                zIndex: visibles.length - i,
                backgroundColor: on ? alpha(colors.primary, 0.16) : colors.surface,
                borderColor: on ? colors.primary : colors.border,
                borderWidth: on ? trazo.fuerte : trazo.fino,
              },
            ]}
          >
            <Text style={s_cat.icon}>{c.icon ?? '📦'}</Text>
          </Pressable>
        );
      })}
      {resto > 0 && (
        <Pressable
          onPress={onVerTodas}
          accessibilityRole="button"
          accessibilityLabel={`Ver todas las categorías, ${resto} más`}
          style={[s_cat.avatar, { marginLeft: espaciado.sm, backgroundColor: colors.surface, borderColor: colors.border, borderWidth: trazo.fino }]}
        >
          <Text style={[s_cat.avatarMasTexto, { color: colors.primary }]}>+{resto}</Text>
        </Pressable>
      )}
    </View>
  );
}

/**
 * Esqueleto del stack: **los mismos círculos, el mismo solape, el mismo alto**. Un esqueleto que no
 * mide lo que va a medir el contenido real es una promesa falsa: hace saltar la pantalla cuando
 * llegan los datos. El anterior eran 5 cuadrados de 46 en fila con `gap` — ni el número, ni la
 * forma, ni el alto. La píldora «+N» no se dibuja porque con el catálogo sin cargar todavía no se
 * sabe si hará falta (siempre aparece de las 22 categorías hacia arriba).
 */
function AvatarStackEsqueleto({ colors }: { colors: ReturnType<typeof useTheme>['colors'] }) {
  return (
    <View style={s_cat.stack}>
      {Array.from({ length: MAX_AVATARES_CAT }).map((_, i) => (
        <View
          key={i}
          style={[s_cat.avatar, {
            marginLeft: i === 0 ? 0 : -SOLAPE_AVATAR,
            zIndex: MAX_AVATARES_CAT - i,
            backgroundColor: colors.border,
            borderColor: colors.border,
            borderWidth: trazo.fino,
          }]}
        />
      ))}
    </View>
  );
}

const s_cat = StyleSheet.create({
  /**
   * Ancho EXPLÍCITO de un cuarto: es lo que obliga a que haya 4 columnas por fila (`GRID_COLS`).
   * Antes era `flex: 1, maxWidth: '20%'`, o sea base 0 — y con la base a 0 el `flexWrap` no
   * llegaba a partir la fila: las once celdas cabían «en teoría» en una línea y acababan
   * comprimidas. Con `width` no hay ambigüedad. Y son 90 dp de celda, no 72: ver `GRID_COLS`.
   */
  cell: { width: '25%', alignItems: 'center', paddingVertical: espaciado.sm },
  iconWrap: { width: DIAM_AVATAR, height: DIAM_AVATAR, borderRadius: radios.full, alignItems: 'center', justifyContent: 'center', marginBottom: espaciado.sm },
  /** Emoji: `ilustracion.sm` (20), no `md` (36). Cabe de sobra en 48 dp y es el tamaño que la
   *  escala reserva a un emoji «en línea, dentro de una fila» — que es exactamente lo que es. */
  icon: { fontSize: ilustracion.sm },
  /**
   * **Dos líneas, no una.** Con 1 línea «Frutas y verduras» (122 dp) no cabe en los 90 dp de la
   * celda y sale con puntos suspensivos; con 2 líneas se reparte por palabras («Frutas y» /
   * «verduras») y se lee entera. El defecto original no venía de permitir dos líneas —eso ya
   * estaba— sino de que la celda medía 98 px en vez de 270: la palabra «verduras» no cabía en
   * ninguna de las dos. La elipsis queda como red por si aparecen etiquetas nuevas muy largas.
   * Token `micro` (11) en vez del 10.5 a mano que llevaba, que era deuda de la guardia.
   */
  label: { fontSize: tipografia.micro, fontWeight: peso.fuerte, textAlign: 'center', paddingHorizontal: 2 },
  /** La fila del stack. Centrada: el ancho es fijo (264 dp con 6 + píldora) y no llena los 328
   *  disponibles, así que alinearla a la izquierda dejaría un hueco a la derecha que se lee como
   *  error, no como margen. */
  stack: { flexDirection: 'row', alignItems: 'center', justifyContent: 'center', paddingVertical: espaciado.sm },
  avatar: { width: DIAM_AVATAR, height: DIAM_AVATAR, borderRadius: radios.full, alignItems: 'center', justifyContent: 'center' },
  avatarMasTexto: { fontSize: tipografia.body, fontWeight: peso.titulo },
});

function SubChip({ label, active, onPress }: { label: string; active: boolean; onPress: () => void }) {
  const { colors } = useTheme();
  return (
    <Pressable onPress={onPress} accessibilityRole="button" accessibilityLabel={label}
      style={{ paddingHorizontal: 12, paddingVertical: 6, borderRadius: radios.md, backgroundColor: active ? colors.primary : colors.surface, borderWidth: 1, borderColor: active ? colors.primary : colors.border }}>
      <Text style={{ fontSize: tipografia.caption, fontWeight: '700', color: active ? brand.white : colors.textPrimary }}>{label}</Text>
    </Pressable>
  );
}

/** Aquí vivía `CatSkeletonGrid` (5 cuadrados de 46 en fila, sin solape, con una barrita debajo).
 *  Se retiró al pasar la home al avatar stack: un esqueleto tiene que medir lo que va a medir el
 *  contenido, y aquel no coincidía en número, ni en forma, ni en alto. Su sustituto es
 *  `AvatarStackEsqueleto`, que dibuja exactamente los mismos círculos y el mismo solape. */

const styles = (c: ReturnType<typeof useTheme>['colors']) => StyleSheet.create({
  root: { flex: 1, backgroundColor: c.background },
  /**
   * Fondo SÓLIDO + elevación: es lo que despega la cabecera del catálogo que se desliza por
   * debajo. Sin `backgroundColor` la barra era transparente y, al desplazar, la fila de tarjetas
   * cortada por el borde de la lista se leía pegada al título, sin separación ninguna.
   * `paddingVertical` bajó de 12 a 8 al mudarse aquí la barra de búsqueda: 8 + 40 + 8 = 56 dp de
   * cabecera, el alto estándar de una barra de app de Android. Con 12 serían 64 y se comía el
   * sitio de una tarjeta y media.
   */
  header: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: espaciado.lg, paddingVertical: espaciado.sm, backgroundColor: c.background, borderBottomWidth: trazo.fino, borderBottomColor: c.border, zIndex: 2, elevation: 2 },
  headerActions: { flexDirection: 'row', alignItems: 'center', gap: 14 },
  cartBadge: { position: 'absolute', top: -6, right: -8, minWidth: 16, height: 16, borderRadius: radios.sm, backgroundColor: brand.like, alignItems: 'center', justifyContent: 'center', paddingHorizontal: 3 },
  cartBadgeText: { color: brand.white, fontSize: tipografia.micro, fontWeight: peso.titulo },
  /**
   * La barra de búsqueda, en la cabecera. `height: 40` en vez de `paddingVertical`: es lo que la
   * hace caber junto a los tres iconos de acción y quedar centrada con ellos, y evita que el alto
   * dependa del `font_scale` del usuario (con un `paddingVertical` fijo, a 1.3 de escala la barra
   * crecía y desalineaba la fila entera). Los 40 dp son de la barra, no del área táctil: la barra
   * entera es el campo, así que el alto táctil ya es de sobra.
   */
  headerSearch: { flex: 1, flexDirection: 'row', alignItems: 'center', marginHorizontal: espaciado.md, height: 40, paddingHorizontal: espaciado.md, backgroundColor: c.surface, borderRadius: radios.md, borderWidth: trazo.fino, borderColor: c.border },
  /** `paddingVertical: 0` es obligatorio en Android: el `TextInput` trae relleno vertical propio y,
   *  sin quitarlo, desborda los 40 dp de la barra por arriba y por abajo. */
  searchInput: { flex: 1, color: c.textPrimary, fontSize: tipografia.body, marginLeft: espaciado.sm, paddingVertical: 0 },
  cityRow: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: 16, marginTop: 12 },
  cityPicker: { flexDirection: 'row', alignItems: 'center', gap: 6, paddingHorizontal: 12, paddingVertical: 8, borderRadius: radios.md, borderWidth: 1 },
  cityLabel: { fontSize: tipografia.caption, fontWeight: '800', color: c.textPrimary },
  cityItem: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: 20, paddingVertical: 13, borderBottomWidth: 1 },
  sectionHead: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: 16, marginTop: 16, marginBottom: 8 },
  sectionTitle: { fontSize: tipografia.body, fontWeight: '800', color: c.textPrimary },
  seeAll: { fontSize: tipografia.caption, fontWeight: peso.fuerte, color: c.primary },
  subRow: { marginTop: 8, paddingLeft: 16 },
  resultsLabel: { fontSize: tipografia.caption, fontWeight: '700', color: c.textSecondary, paddingHorizontal: 16, marginTop: 16, marginBottom: 10 },
  colWrap: { gap: 10, paddingHorizontal: 16 },
  listContent: { paddingBottom: 32 },
  modalWrap: { flex: 1, backgroundColor: 'rgba(0,0,0,0.45)', justifyContent: 'flex-end' },
  modalCard: { borderTopLeftRadius: radios.lg, borderTopRightRadius: radios.lg, paddingTop: 14, maxHeight: '78%' },
  modalHead: { flexDirection: 'row', alignItems: 'center', justifyContent: 'space-between', paddingHorizontal: 20, paddingBottom: 10 },
  modalTitle: { fontSize: tipografia.subtitle, fontWeight: '800', color: c.textPrimary },
  photoBanner: { marginHorizontal: 16, marginTop: 12, borderRadius: radios.md, borderWidth: 1, padding: 14, alignItems: 'center' },
  photoBannerTitle: { fontSize: tipografia.body, fontWeight: '800' },
  photoBannerSub: { fontSize: tipografia.caption, marginTop: 4 },
  photoBack: { marginTop: 10, paddingHorizontal: 14, paddingVertical: 7, borderRadius: radios.lg, backgroundColor: c.primary },
  photoBackText: { color: brand.white, fontSize: tipografia.caption, fontWeight: '800' },
});
